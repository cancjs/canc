{
 "name": "@cancjs/toolbox-native",
 "version": "0.0.0",
 "description": "Promise timing/retry on native Promise (no cancellation).",
 "keywords": [],
 "main": "dist/index.cjs",
 "module": "dist/index.mjs",
 "unpkg": "dist/index.umd.min.js",
 "jsdelivr": "dist/index.umd.min.js",
 "types": "dist/types/index.d.ts",
 "sideEffects": false,
 "files": [
 "dist"
 ],
 "typesVersions": {
 "<4.7": {
 "dist/types/*": [
 "dist/types-ts4.2/*"
 ]
 }
 },
 "exports": {
 ".": {
 "types@<4.7": "./dist/types-ts4.2/index.d.ts",
 "types": "./dist/types/index.d.ts",
 "import": "./dist/index.mjs",
 "require": "./dist/index.cjs"
 }
 },
 "engines": {
 "node": ">=18",
 "npm": ">=9"
 },
 "author": "bisubus",
 "license": "MIT",
 "homepage": "https://github.com/cancjs/canc/packages/canc-toolbox-native#readme",
 "repository": {
 "type": "git",
 "url": "git+https://github.com/cancjs/canc.git",
 "directory": "packages/canc-toolbox-native"
 },
 "bugs": {
 "url": "https://github.com/cancjs/canc/issues"
 },
 "publishConfig": {
 "access": "public"
 },
 "scripts": {
 "build": "rimraf dist && rollup --config ./rollup.config.mjs",
 "check": "tsc --noEmit --project ./tsconfig.prod.json",
 "format:src": "eslint --fix ./src",
 "format": "eslint --fix .",
 "lint:src": "eslint ./src",
 "lint": "eslint .",
 "test": "jest --colors",
 "test:watch": "jest --colors --watch"
 },
 "type": "commonjs"
}
