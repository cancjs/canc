// Dummy tsconfig used by IDE TS & ESLint
// for both production and test code
// https://github.com/microsoft/vscode/issues/12463
{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "paths": {
      "@cancjs/promise": ["./packages/canc-promise/src/index"],
      "@cancjs/node": ["./packages/canc-node/src/index"],
      "@cancjs/node/fs": ["./packages/canc-node/src/fs/index"],
      "@cancjs/node/fs/sync": ["./packages/canc-node/src/fs/sync"],
      "@cancjs/node/fs/register-graceful": [
        "./packages/canc-node/src/fs/register-graceful"
      ],
      "@cancjs/node/fs/extra": ["./packages/canc-node/src/fs-extra/index"],
      "@cancjs/node/child-process": [
        "./packages/canc-node/src/child-process/index"
      ],
      "@cancjs/*": ["./packages/canc-*/src"]
    }
  },
  "include": ["src"]
}
