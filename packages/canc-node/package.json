{
  "name": "@cancjs/node",
  "version": "0.0.0",
  "description": "Node built-in modules with cancelable promises and typed failures.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancjs/canc.git",
    "directory": "packages/canc-node"
  },
  "homepage": "https://github.com/cancjs/canc/tree/master/packages/canc-node#readme",
  "bugs": "https://github.com/cancjs/canc/issues",
  "author": "bisubus",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types@<4.7": "./dist/types-ts4.2/index.d.mts",
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types@<4.7": "./dist/types-ts4.2/index.d.ts",
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": ["./dist/fs/register-graceful.*"],
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config ./rollup.config.mjs",
    "check": "tsc --noEmit --project ./tsconfig.prod.json",
    "format:src": "eslint --fix ./src",
    "format": "eslint --fix .",
    "lint:src": "eslint ./src",
    "lint": "eslint .",
    "test": "jest --colors",
    "test:watch": "jest --colors --watch",
    "// surface": "Authoritative sequence: npm run check:node-surface (surface:validate -> surface:check)",
    "surface:check": "node ../../scripts/node/surface-check.mjs",
    "surface:docs": "node ../../scripts/node/surface-docs.mjs",
    "surface:lock": "node ../../scripts/node/api-lock.mjs"
  },
  "files": ["dist"],
  "keywords": ["node", "fs", "cancel", "cancelable", "cancellation", "canc"],
  "devDependencies": {
    "@cancjs/promise": "*"
  },
  "peerDependencies": {
    "@cancjs/promise": ">=1.0.0",
    "graceful-fs": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "graceful-fs": {
      "optional": true
    }
  },
  "typesVersions": {
    "<4.7": {
      "dist/types/*": ["dist/types-ts4.2/*"]
    }
  }
}
