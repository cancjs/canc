  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config ./rollup.config.mjs",
    "check": "tsc --noEmit --project ./tsconfig.prod.json",
    "format:src": "eslint --fix ./src",
    "format": "eslint --fix .",
    "lint:src": "eslint ./src",
    "lint": "eslint .",
    "test": "jest --colors",
    "test:watch": "jest --colors --watch",
    "// surface": "Authoritative sequence: npm run check:node-surface (surface:validate -> surface:check)",
    "surface:check": "node ../../scripts/node/surface-check.mjs",
    "surface:docs": "node ../../scripts/node/surface-docs.mjs",
    "surface:lock": "node ../../scripts/node/api-lock.mjs"
  },
  "files": ["dist"],
  "keywords": ["node", "fs", "cancel", "cancelable", "cancellation", "canc"],
  "devDependencies": {
    "@cancjs/promise": "*"
  },
  "peerDependencies": {
    "@cancjs/promise": ">=1.0.0",
    "graceful-fs": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "graceful-fs": {
      "optional": true
    }
  },
  "typesVersions": {
    "<4.7": {
      "dist/types/*": ["dist/types-ts4.2/*"],
      "child-process": ["dist/types-ts4.2/child-process/index.d.ts"]
    },
    "*": {
      "fs": ["dist/types/fs/index.d.ts"],
      "fs/sync": ["dist/types/fs/sync.d.ts"],
      "fs/register-graceful": ["dist/types/fs/register-graceful.d.ts"],
      "fs/extra": ["dist/types/fs-extra/index.d.ts"],
