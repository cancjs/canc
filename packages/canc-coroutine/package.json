{
  "name": "@cancjs/coroutine",
  "version": "1.0.0",
  "description": "Cancelable generator-based drop-in replacements for async/await and async iterators.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancjs/canc.git",
    "directory": "packages/canc-coroutine"
  },
  "homepage": "https://github.com/cancjs/canc/packages/canc-coroutine#readme",
  "bugs": "https://github.com/cancjs/canc/issues",
  "author": "bisubus",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types@<4.7": "./dist/types-ts4.2/index.d.mts",
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types@<4.7": "./dist/types-ts4.2/index.d.ts",
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./gen": {
      "import": {
        "types@<4.7": "./dist/types-ts4.2/gen.d.mts",
        "types": "./dist/types/gen.d.mts",
        "default": "./dist/gen.mjs"
      },
      "require": {
        "types@<4.7": "./dist/types-ts4.2/gen.d.ts",
        "types": "./dist/types/gen.d.ts",
        "default": "./dist/gen.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config ./rollup.config.mjs",
    "check": "tsc --noEmit --project ./tsconfig.prod.json",
    "format:src": "eslint --fix ./src",
    "format": "eslint --fix .",
    "lint:src": "eslint ./src",
    "lint": "eslint .",
    "test": "jest --colors",
    "test:watch": "jest --colors --watch"
  },
  "files": ["dist"],
  "keywords": ["async", "await", "generator", "cancelable"],
  "devDependencies": {
    "@cancjs/promise": "*"
  },
  "peerDependencies": {
    "@cancjs/promise": ">=1.0.0"
  },
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "typesVersions": {
    "<4.7": {
      "dist/types/*": ["dist/types-ts4.2/*"]
    },
    "*": {
      "gen": ["dist/types/gen.d.ts"]
    }
  }
}
