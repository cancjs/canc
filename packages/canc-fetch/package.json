 "directory": "packages/canc-fetch"
 },
 "bugs": {
 "url": "https://github.com/cancjs/canc/issues"
 },
 "publishConfig": {
 "access": "public"
 },
 "peerDependencies": {
 "@cancjs/promise": "*",
 "@cancjs/lazy-promise": "*"
 },
 "peerDependenciesMeta": {
