 "require": "./dist/lazy.cjs"
 }
 },
 "engines": {
 "node": ">=18",
 "npm": ">=9"
 },
 "author": "bisubus",
 "license": "MIT",
 "homepage": "https://github.com/cancjs/canc/packages/canc-fetch#readme",
 "repository": {
