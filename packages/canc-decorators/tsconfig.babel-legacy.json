// Per-flavor fixture tsconfig for babel-legacy decorators
// Decorators compile as plain TS with manual descriptors (no babel toolchain)
// Proves source and spec type-check independently under check:babel-legacy
{
  "extends": "../../tsconfig.test",
  "compilerOptions": {
    "experimentalDecorators": false,
    "useDefineForClassFields": false,
    "lib": ["es2022"]
  },
  "include": [
    "src/decorators-babel-legacy.ts",
    "src/decorators-babel-legacy.spec.ts"
  ]
}
