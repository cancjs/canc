{
 "name": "@cancjs/decorators",
 "version": "0.0.0",
 "description": "",
 "keywords": [],
 "main": "dist/index.cjs",
 "module": "dist/index.mjs",
 "unpkg": "dist/index.umd.min.js",
 "jsdelivr": "dist/index.umd.min.js",
 "types": "dist/types/index.d.ts",
 "sideEffects": false,
 "files": [
 "dist"
 ],
 "exports": {
 ".": {
 "types": "./dist/types/index.d.ts",
 "import": "./dist/index.mjs",
 "require": "./dist/index.cjs"
 },
 "./legacy": {
 "types": "./dist/types/legacy.d.ts",
 "import": "./dist/legacy.mjs",
 "require": "./dist/legacy.cjs"
 },
 "./babel-legacy": {
 "types": "./dist/types/babel-legacy.d.ts",
 "import": "./dist/babel-legacy.mjs",
 "require": "./dist/babel-legacy.cjs"
 }
 },
 "engines": {
 "node": ">=18",
 "npm": ">=9"
 },
 "author": "bisubus",
 "license": "MIT",
 "homepage": "https://github.com/cancjs/canc/packages/canc-decorators#readme",
 "repository": {
 "type": "git",
 "url": "https://github.com/cancjs/canc.git",
 "directory": "packages/canc-decorators"
 },
 "bugs": {
 "url": "https://github.com/cancjs/canc/issues"
 },
 "publishConfig": {
 "access": "public"
 },
 "devDependencies": {
 "reflect-metadata": "~0.2.2",
 "@babel/core": "7.29.7",
 "@babel/preset-env": "7.28.6",
 "@babel/preset-typescript": "7.29.7",
 "@babel/plugin-proposal-decorators": "7.29.7",
 "babel-jest": "30.4.1"
 },
 "scripts": {
 "build": "rimraf dist && rollup --config ./rollup.config.js",
 "check": "tsc --noEmit --project ./tsconfig.prod.json",
 "check:stage3": "tsc --noEmit --project ./tsconfig.stage3.json",
 "check:legacy": "tsc --noEmit --project ./tsconfig.legacy.json",
 "check:babel-legacy": "tsc --noEmit --project ./tsconfig.babel-legacy.json",
 "format": "eslint --fix ./src",
 "format:all": "eslint --fix .",
 "lint": "eslint ./src",
 "lint:all": "eslint .",
 "test": "jest --colors",
 "test:watch": "jest --colors --watch"
 },
 "peerDependencies": {
 "@cancjs/promise": "^0.0.0",
 "@cancjs/coroutine": "^0.0.0"
 }
}
