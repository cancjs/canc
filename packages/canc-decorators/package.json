{
  "name": "@cancjs/decorators",
  "version": "1.0.0",
  "description": "Class method decorators for cancelable coroutines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancjs/canc.git",
    "directory": "packages/canc-decorators"
  },
  "homepage": "https://github.com/cancjs/canc/packages/canc-decorators#readme",
  "bugs": "https://github.com/cancjs/canc/issues",
  "author": "bisubus",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./legacy": {
      "import": {
        "types": "./dist/types/legacy.d.mts",
        "default": "./dist/legacy.mjs"
      },
      "require": {
        "types": "./dist/types/legacy.d.ts",
        "default": "./dist/legacy.cjs"
      }
    },
    "./babel-legacy": {
      "import": {
        "types": "./dist/types/babel-legacy.d.mts",
        "default": "./dist/babel-legacy.mjs"
      },
      "require": {
        "types": "./dist/types/babel-legacy.d.ts",
        "default": "./dist/babel-legacy.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config ./rollup.config.js",
    "check": "tsc --noEmit --project ./tsconfig.prod.json",
    "check:stage3": "tsc --noEmit --project ./tsconfig.stage3.json",
    "check:legacy": "tsc --noEmit --project ./tsconfig.legacy.json",
    "check:babel-legacy": "tsc --noEmit --project ./tsconfig.babel-legacy.json",
    "format:src": "eslint --fix ./src",
    "format": "eslint --fix .",
    "lint:src": "eslint ./src",
    "lint": "eslint .",
    "test": "jest --colors",
    "test:watch": "jest --colors --watch"
  },
  "files": ["dist"],
  "keywords": ["decorators", "async", "cancelable", "class"],
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/preset-env": "7.28.6",
    "@babel/preset-typescript": "7.29.7",
    "@cancjs/coroutine": "*",
    "@cancjs/promise": "*",
    "babel-jest": "30.4.1",
    "reflect-metadata": "~0.2.2"
  },
  "peerDependencies": {
    "@cancjs/coroutine": ">=1.0.0",
    "@cancjs/promise": ">=1.0.0"
  },
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "typesVersions": {
    "*": {
      "legacy": ["dist/types/legacy.d.ts"],
      "babel-legacy": ["dist/types/babel-legacy.d.ts"]
    }
  }
}
