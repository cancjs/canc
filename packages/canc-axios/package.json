{
  "name": "@cancjs/axios",
  "version": "1.0.0",
  "description": "Cancelable promise adapter for axios.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancjs/canc.git",
    "directory": "packages/canc-axios"
  },
  "homepage": "https://github.com/cancjs/canc/tree/master/packages/canc-axios#readme",
  "bugs": "https://github.com/cancjs/canc/issues",
  "author": "bisubus",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup --config ./rollup.config.js",
    "check": "tsc --noEmit --project ./tsconfig.prod.json",
    "format:src": "eslint --fix ./src",
    "format": "eslint --fix .",
    "lint:src": "eslint ./src",
    "lint": "eslint .",
    "test": "jest --colors",
    "test:watch": "jest --colors --watch"
  },
  "files": ["dist"],
  "keywords": ["axios", "cancel", "cancelable", "abort", "promise"],
  "devDependencies": {
    "@cancjs/promise": "*",
    "@cancjs/toolbox": "*",
    "axios": "1.16.0",
    "axios-legacy": "npm:axios@0.22.0"
  },
  "peerDependencies": {
    "@cancjs/promise": ">=1.0.0",
    "@cancjs/toolbox": ">=1.0.0",
    "axios": ">=0.22"
  },
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js"
}
