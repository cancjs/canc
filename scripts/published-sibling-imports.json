        "CancelError",
        "CancelablePromise",
        "ICancelablePromiseOptions",
        "IPromiseImplOptions",
        "isCancelError"
      ],
      "@cancjs/toolbox": ["IToolboxOptions", "cancelify"]
    },
    "@cancjs/coroutine@1.0.0": {
      "@cancjs/promise": [
        "CancelError",
        "CancelablePromise",
        "ICancelablePromiseOptions",
        "isCancelError"
      ]
    },
    "@cancjs/decorators@1.0.0": {
      "@cancjs/coroutine": ["async"]
    },
    "@cancjs/fetch@1.0.0": {
