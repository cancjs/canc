{
  "$comment": "Measured with: tmp=$(mktemp -d); for p in axios coroutine decorators fetch node toolbox unhandled-rejection server-{express,fastify,hono,koa,node}; do npm pack @cancjs/$p@1.0.0 --pack-destination $tmp >/dev/null; done; for t in $tmp/*.tgz; do tar -xzf $t -C $tmp; grep -rhoE \"@cancjs/[a-z-]+\" $tmp/package/dist/ | sort -u; rm -rf $tmp/package; done; rm -rf $tmp",
