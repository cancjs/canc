{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "cancjs/canc" }],
  "commit": false,
  "access": "public",
  "baseBranch": "master",
  "updateInternalDependencies": "minor",
  "fixed": [["@cancjs/promise"]],
  "linked": [
    [
      "@cancjs/toolbox",
      "@cancjs/toolbox-native",
      "@cancjs/decorators",
      "@cancjs/fetch",
      "@cancjs/axios",
      "@cancjs/unhandled-rejection",
      "@cancjs/server-node",
      "@cancjs/server-express",
      "@cancjs/server-fastify",
      "@cancjs/server-koa",
      "@cancjs/server-hono"
    ]
  ],
  "ignore": ["@cancjs/benchmarks", "@cancjs/tests-types"],
  "___experimentalUnsafeOptions_WILL_CHANGE_IN_PATCH": {
    "onlyUpdatePeerDependentsWhenOutOfRange": true
  }
}
