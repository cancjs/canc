{
 "name": "canc",
 "version": "0.0.0",
 "private": true,
 "author": "bisubus",
 "license": "MIT",
 "workspaces": [
 "packages/*",
 "benchmarks",
 "tests-types"
 ],
 "engines": {
 "yarn": ">=1"
 },
 "resolutions": {
 "downlevel-dts/typescript": "~5.9.3"
 },
 "scripts": {
 "build": "cross-env NODE_OPTIONS=--no-deprecation lerna run build --stream",
 "test": "cross-env NODE_OPTIONS=--no-deprecation lerna run test --stream",
 "lint": "cross-env NODE_OPTIONS=--no-deprecation lerna run lint --stream",
 "publish": "cross-env NODE_OPTIONS=--no-deprecation lerna publish from-git",
 "version": "cross-env NODE_OPTIONS=--no-deprecation lerna version --no-push",
 "bench": "yarn workspace @cancjs/benchmarks bench",
 "bench:report": "yarn workspace @cancjs/benchmarks bench:report",
 "bench:browser": "yarn workspace @cancjs/benchmarks bench:browser"
 },
 "devDependencies": {
 "@eslint/js": "~9.39.0",
 "@rollup/plugin-commonjs": "~25.0.8",
 "@rollup/plugin-node-resolve": "~15.2.3",
 "@rollup/plugin-terser": "~1.0.0",
 "@rollup/plugin-typescript": "~12.2.0",
 "@stylistic/eslint-plugin": "~5.10.0",
 "@types/jest": "~30.0.0",
 "@types/node": "~20.12.12",
 "cross-env": "~7.0.3",
 "downlevel-dts": "~0.11.0",
 "eslint": "~9.39.0",
 "fast-check": "~4.9.0",
 "globals": "~17.7.0",
 "jest": "~30.4.2",
 "lerna": "~9.0.7",
 "rimraf": "~5.0.7",
 "rollup": "~4.62.2",
 "rollup-plugin-filesize": "~10.0.0",
 "rollup-plugin-node-externals": "~7.1.2",
 "rollup-plugin-progress": "~1.1.2",
 "ts-jest": "~29.4.11",
 "tslib": "~2.8.1",
 "typescript": "~5.9.3",
 "typescript-eslint": "~8.63.0"
 }
}
