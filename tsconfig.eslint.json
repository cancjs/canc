// Project used only for typed linting from the repo root.
//
// The root tsconfig.json is a dummy for the IDE and includes no files, and each package tsconfig
// only includes its own src. That leaves the shared inlinable dirs (packages/_util, _toolbox and
// _server) and the tooling scripts belonging to no project, so a root-level `eslint .` cannot get
// type information for them. This config covers everything the linter should see.
{
  "extends": "./tsconfig.test",
  "compilerOptions": {
    "lib": ["es2022", "dom"]
  },
  "include": [
    "packages/canc-*",
    "packages/_util",
    "packages/_toolbox",
    "packages/_server",
    "tests-types",
    "benchmarks",
    "tests-dist"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/~~**/*",
    "**/**~~/*",
    "**/build/**/*",
    // Manual runtime checks, run by their own runtime (bun, deno) with that runtime's resolver.
    "**/smoke/**",
    "**/dist/**/*",
    "tests-types/fixtures/ts-*/**",
    "tests-types/fixtures/common/async-iter-types.ts"
  ]
}
