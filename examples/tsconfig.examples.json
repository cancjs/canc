{
 "compilerOptions": {
 "target": "es2020",
 "module": "esnext",
 "lib": ["es2022", "dom"],
 "moduleResolution": "bundler",
 "strict": true,
 "esModuleInterop": true,
 "skipLibCheck": true,
 "forceConsistentCasingInFileNames": true,
 "resolveJsonModule": true,
 "declaration": true,
 "declarationMap": true,
 "sourceMap": true,
 "jsx": "react-jsx",
 "experimentalDecorators": true
 },
 "include": ["**/*.ts", "**/*.tsx"],
 "exclude": [
 "**/node_modules/**",
 "**/dist/**",
 "**/build/**",
 "**/*.spec.ts",
 "~~legacy examples/**",
 "app-vue-pinia/**",
 "app-react-mobx/**",
 "app-react/**",
 "app-express-kysely/**",
 "demo-decorators/**"
 ]
}
