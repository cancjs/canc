{
 "compilerOptions": {
 "target": "es2020",
 "module": "nodenext",
 "moduleResolution": "nodenext",
 "lib": ["es2022", "dom"],
 "types": ["node", "jest"],

 "baseUrl": ".",
 "strict": true,
 "esModuleInterop": true,
 "forceConsistentCasingInFileNames": true,
 "resolveJsonModule": true,
 "skipLibCheck": true,
 "noEmit": true,

 "declaration": false,
 "sourceMap": false,

 "paths": {
 "@shared/*": ["_shared/*/src"]
 }
 },
 "include": [
 "_shared/**/*.ts",
 "demo-promise-basics/**/*.ts",
 "demo-async-dispose/**/*.ts",
 "demo-chain-propagation/**/*.ts",
 "demo-coroutine/**/*.ts",
 "demo-lazy-promise/**/*.ts",
 "demo-fetch/**/*.ts"
 ],
 "exclude": [
 "**/node_modules/**",
 "**/dist/**",
 "**/~~*",
 "**/*~~*"
 ]
}
