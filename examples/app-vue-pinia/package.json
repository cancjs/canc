{
 "name": "app-vue-pinia",
 "version": "0.0.0",
 "private": true,
 "description": "Multi-step checkout wizard (address, shipping, review) backed by a Pinia store: step navigation cancels the abandoned step's in-flight call.",
 "scripts": {
 "dev:vanilla": "vite --config vite.config.ts --open /vanilla.html",
 "dev:canc": "vite --config vite.config.ts --open /canc.html",
 "start:vanilla": "vite build --config vite.config.ts && vite preview --config vite.config.ts --open /vanilla.html",
 "start:canc": "vite build --config vite.config.ts && vite preview --config vite.config.ts --open /canc.html",
 "test": "jest --colors",
 "typecheck": "vue-tsc --noEmit --project tsconfig.json"
 },
 "dependencies": {
 "@shared/mock-api": "*",
 "@shared/unhandled-rejection-browser": "*",
 "@cancjs/promise": "link:../../packages/canc-promise",
 "@cancjs/coroutine": "link:../../packages/canc-coroutine",
 "@cancjs/toolbox": "link:../../packages/canc-toolbox",
 "pinia": "4.0.2",
 "vue": "3.5.40",
 "vue-router": "5.2.0"
 },
 "devDependencies": {
 "@testing-library/dom": "10.4.1",
 "@testing-library/jest-dom": "6.9.1",
 "@testing-library/vue": "8.1.0",
 "@types/jest": "30.0.0",
 "@types/node": "20.12.12",
 "@vitejs/plugin-vue": "6.0.8",
 "@vue/vue3-jest": "29.2.6",
 "@vue/test-utils": "2.4.11",
 "@vue/tsconfig": "0.9.1",
 "jest": "30.4.2",
 "jest-environment-jsdom": "30.4.1",
 "ts-jest": "29.4.11",
 "typescript": "5.9.3",
 "vite": "8.1.5",
 "vue-tsc": "3.3.7"
 }
}
