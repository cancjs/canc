{
  "name": "canc-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Examples workspace for canc",
  "workspaces": [
    "_shared/mock-api",
    "_shared/util",
    "_shared/lib",
    "app-ai-chat-stop",
    "app-ai-rag-pipeline",
    "app-angular",
    "app-axios",
    "app-cli-graceful",
    "app-crawler-race",
    "app-express-kysely",
    "app-fetch-streaming",
    "app-fastify-mongoose",
    "app-fullstack-cancel",
    "app-invoice-scheduler-task",
    "app-nestjs-typeorm",
    "app-react",
    "app-react-suspense",
    "app-react-zustand",
    "app-rxjs",
    "app-vue",
    "app-vue-pinia",
    "app-vue-suspense",
    "app-ws-progress",
    "demo-async-dispose",
    "demo-async-iter",
    "demo-chain-propagation",
    "demo-combinators",
    "demo-coroutine",
    "demo-decorators",
    "demo-fetch",
    "demo-promise-basics",
    "demo-signal-interop",
    "demo-toolbox"
  ],
  "scripts": {
    "examples:typecheck": "tsc --noEmit --project tsconfig.examples.json",
    "test:aggregate": "jest --colors",
    "test:kysely": "npm run test --prefix app-express-kysely",
    "examples:test": "node -e \"const s=(c)=>{try{require('child_process').execSync(c,{stdio:'inherit'})}catch{process.exitCode=1}}; s('npm run test:aggregate'); s('npm run test:kysely');\"",
    "examples:lint": "eslint .",
    "examples:format": "eslint --fix ."
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "eslint-plugin-vue": "10.10.0",
    "glob": "10.5.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "typescript": "^5.4.0",
    "vue-eslint-parser": "10.4.1"
  },
  "engines": {
    "npm": ">=9"
  }
}
