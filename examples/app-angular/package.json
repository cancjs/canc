{
  "name": "app-angular",
  "version": "0.0.0",
  "private": true,
  "description": "Admin orders dashboard in Angular: switching rows cancels the previous detail load, destroy cancels everything. Decorator and manual service canc flavors, plus an HttpClient-to-CancelablePromise bridge.",
  "scripts": {
    "start:canc": "ng serve -c canc",
    "start:vanilla": "ng serve -c vanilla",
    "start:obs": "ng serve -c obs",
    "dev:canc": "ng serve -c canc",
    "dev:vanilla": "ng serve -c vanilla",
    "dev:obs": "ng serve -c obs",
    "build:canc": "ng build -c canc",
    "build:vanilla": "ng build -c vanilla",
    "build:obs": "ng build -c obs",
    "test": "jest --colors",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "18.2.14",
    "@angular/compiler": "18.2.14",
    "@angular/core": "18.2.14",
    "@angular/platform-browser": "18.2.14",
    "@angular/platform-browser-dynamic": "18.2.14",
    "@cancjs/coroutine": "file:../../packages/canc-coroutine",
    "@cancjs/decorators": "file:../../packages/canc-decorators",
    "@cancjs/promise": "file:../../packages/canc-promise",
    "@cancjs/toolbox": "file:../../packages/canc-toolbox",
    "@cancjs/unhandled-rejection": "file:../../packages/canc-unhandled-rejection",
    "@shared/mock-api": "*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.21",
    "@angular/cli": "18.2.21",
    "@angular/compiler-cli": "18.2.14",
    "@types/jest": "30.0.0",
    "@types/node": "20.12.12",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "npm": ">=9"
  }
}
