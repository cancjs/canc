{
 "compilerOptions": {
 "target": "es2020",
 "module": "commonjs",
 "lib": ["es2022"],
 "moduleResolution": "node",
 "strict": true,
 "esModuleInterop": true,
 "skipLibCheck": true,
 "forceConsistentCasingInFileNames": true,
 "resolveJsonModule": true,
 "declaration": true,
 "declarationMap": true,
 "sourceMap": true
 },
 "include": ["src"]
}
