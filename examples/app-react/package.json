{
 "name": "app-react",
 "version": "0.0.0",
 "private": true,
 "description": "Flight search typeahead: each keystroke cancels the previous search chain, hover prefetch cancels on unhover, unmount cancels everything.",
 "scripts": {
 "dev:vanilla": "vite --config vite.vanilla.config.ts",
 "dev:canc": "vite --config vite.canc.config.ts",
 "start:vanilla": "vite --config vite.vanilla.config.ts",
 "start:canc": "vite --config vite.canc.config.ts",
 "build:vanilla": "vite build --config vite.vanilla.config.ts",
 "build:canc": "vite build --config vite.canc.config.ts",
 "test": "jest --colors",
 "typecheck": "tsc --noEmit --project tsconfig.json"
 },
 "dependencies": {
 "@cancjs/promise": "link:../../packages/canc-promise",
 "@cancjs/toolbox": "link:../../packages/canc-toolbox",
 "@shared/mock-api": "*",
