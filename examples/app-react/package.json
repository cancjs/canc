 "react-dom": "18.3.1"
 },
 "devDependencies": {
 "@testing-library/dom": "10.4.1",
 "@testing-library/jest-dom": "6.9.1",
 "@testing-library/react": "16.3.2",
 "@types/jest": "30.0.0",
 "@types/node": "20.12.12",
 "@types/react": "18.3.31",
 "@types/react-dom": "18.3.7",
 "@vitejs/plugin-react": "4.3.4",
 "jest": "30.4.2",
 "jest-environment-jsdom": "30.4.1",
 "ts-jest": "29.4.11",
 "tsx": "4.23.0",
 "typescript": "5.9.3",
 "vite": "6.4.3"
 }
}
