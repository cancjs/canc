// Project for @cancjs/tests-types workspace.
//
// Typechecks the test scripts and the common type fixture assertions against
// the workspace source packages.
{
  "extends": "../tsconfig.test",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "baseUrl": ".",
    "paths": {
      "@cancjs/coroutine/gen": ["../packages/canc-coroutine/src/gen"],
      "@cancjs/decorators/legacy": ["../packages/canc-decorators/src/legacy"],
      "@cancjs/decorators/babel-legacy": [
        "../packages/canc-decorators/src/babel-legacy"
      ],
      "@cancjs/toolbox/async-iter": ["../packages/canc-toolbox/src/async-iter"],
      "@cancjs/server-*": ["../packages/canc-server/canc-server-*/src"],
      "@cancjs/*": ["../packages/canc-*/src"]
    }
  },
  "include": ["scripts", "fixtures/common"],
  "exclude": ["fixtures/ts-*"]
}
