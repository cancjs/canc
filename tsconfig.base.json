{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "lib": ["es2022"],
    "declaration": true,
    "sourceMap": true,
    "downlevelIteration": true,
    // Required because class species features break if class fields are defined on the instance instead of the prototype
    "useDefineForClassFields": false,

    "strict": true,
    "noFallthroughCasesInSwitch": true,

    "moduleResolution": "node",
    // needed so prod builds (tsconfig.prod.json) resolve @cancjs/* aliases same as dev tsconfig.json
    "baseUrl": ".",
    "paths": {
      "@cancjs/promise": ["./packages/canc-promise/src/index"],
      "@cancjs/coroutine": ["./packages/canc-coroutine/src/index"],
      "@cancjs/fetch": ["./packages/canc-fetch/src/index"],
      "@cancjs/axios": ["./packages/canc-axios/src/index"],
      "@cancjs/toolbox": ["./packages/canc-toolbox/src/index"],
      "@cancjs/toolbox-native": ["./packages/canc-toolbox-native/src/index"],
      "@cancjs/decorators": ["./packages/canc-decorators/src/index"],
      "@cancjs/unhandled-rejection": [
        "./packages/canc-unhandled-rejection/src/index"
      ],
      "@cancjs/server-*": ["./packages/canc-server/*/src/index"]
    },
    "typeRoots": ["node_modules/@types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "files": [],
  "references": [
    { "path": "packages/canc-axios" },
    { "path": "packages/canc-coroutine" },
    { "path": "packages/canc-decorators" },
    { "path": "packages/canc-fetch" },
    { "path": "packages/canc-promise" },
    { "path": "packages/canc-toolbox" },
    { "path": "packages/canc-toolbox-native" },
    { "path": "packages/canc-unhandled-rejection" }
  ],
  "exclude": [
    "node_modules",
    "**/~~*",
    "**/*~~*",
    "**/build/**/*",
    "**/dist/**/*",
    "**/__tests__/**/*",
    "**/__mocks__/**/*",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
